{{- $laptop := index .MonitorsByTag "laptop" -}}
{{- $primary := index .MonitorsByTag "primary" -}}

{{- if $primary }}
# primary - Primary external display
monitor=desc:{{$primary.Description}},2560x1440@144.00000,0x0,1,transform,0,vrr,0

# primary - Assigned workspaces:
workspace = 1,monitor:{{$primary.Name}},default:true
workspace = 2,monitor:{{$primary.Name}}
workspace = 3,monitor:{{$primary.Name}}
workspace = 4,monitor:{{$primary.Name}}
workspace = 5,monitor:{{$primary.Name}}
workspace = 6,monitor:{{$primary.Name}}
workspace = 7,monitor:{{$primary.Name}}
workspace = 8,monitor:{{$primary.Name}}
workspace = 9,monitor:{{$primary.Name}}
workspace = 10,monitor:{{$primary.Name}}


exec = hyprctl dispatch moveworkspacetomonitor 1 {{$primary.Name}}
exec = hyprctl dispatch moveworkspacetomonitor 2 {{$primary.Name}}
exec = hyprctl dispatch moveworkspacetomonitor 3 {{$primary.Name}}
exec = hyprctl dispatch moveworkspacetomonitor 4 {{$primary.Name}}
exec = hyprctl dispatch moveworkspacetomonitor 5 {{$primary.Name}}
exec = hyprctl dispatch moveworkspacetomonitor 6 {{$primary.Name}}
exec = hyprctl dispatch moveworkspacetomonitor 7 {{$primary.Name}}
exec = hyprctl dispatch moveworkspacetomonitor 8 {{$primary.Name}}
exec = hyprctl dispatch moveworkspacetomonitor 9 {{$primary.Name}}
exec = hyprctl dispatch moveworkspacetomonitor 10 {{$primary.Name}}

{{- end }}

{{- if $laptop }}
# laptop - Laptop monitor is going to be turned off in this setup 

monitor=desc:{{$laptop.Description}},disable

{{- end }}

